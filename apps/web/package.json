{
  "name": "@luckyplans/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs');['.next','.turbo'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@apollo/client": "^4.2.4",
    "@heroui/react": "^3.1.0",
    "@heroui/styles": "^3.1.0",
    "@luckyplans/shared": "workspace:*",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-query": "^5.100.14",
    "clsx": "^2.1.1",
    "framer-motion": "^12.36.0",
    "graphql": "^16.8.0",
    "lucide-react": "^1.22.0",
    "next": "^16.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@luckyplans/config": "workspace:*",
    "@next/eslint-plugin-next": "^16.3.3",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
